# ─── Dominio ──────────────────────────────────────────────────────────────────
DOMAIN=ituc.sebastianartaza.com

# ─── URLs de Magento ──────────────────────────────────────────────────────────
# IMPORTANTE: no uses ${DOMAIN} aquí, los archivos .env no interpoláan variables
MAGENTO_BASE_URL=https://ituc.sebastianartaza.com/
MAGENTO_BASE_URL_SECURE=https://ituc.sebastianartaza.com/

# ─── Administrador ────────────────────────────────────────────────────────────
MAGENTO_ADMIN_FIRSTNAME=Admin
MAGENTO_ADMIN_LASTNAME=User
MAGENTO_ADMIN_EMAIL=admin@ituc.sebastianartaza.com
MAGENTO_ADMIN_USER=admin
MAGENTO_ADMIN_PASSWORD=Admin123!

# ─── Base de datos ────────────────────────────────────────────────────────────
DB_HOST=mysql
DB_NAME=magento
DB_USER=magento
DB_PASSWORD=magento123
MYSQL_ROOT_PASSWORD=root123

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_HOST=redis

# ─── PHP ──────────────────────────────────────────────────────────────────────
PHP_MEMORY_LIMIT=2048M
PHP_MAX_EXECUTION_TIME=3600

# ─── Varnish ──────────────────────────────────────────────────────────────────
VARNISH_SIZE=1G

# ─── OpenSearch ───────────────────────────────────────────────────────────────
OPENSEARCH_JAVA_OPTS=-Xms512m -Xmx512m
# OPENSEARCH_INITIAL_ADMIN_PASSWORD ya no es necesario con DISABLE_SECURITY_PLUGIN=true
# pero se deja para compatibilidad con la imagen
OPENSEARCH_INITIAL_ADMIN_PASSWORD=MyStrongPassword123!
